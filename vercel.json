{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "functions": {
    "app/api/admin/**": {
      "maxDuration": 30
    },
    "app/api/billing/**": {
      "maxDuration": 30
    },
    "app/api/payments/**": {
      "maxDuration": 30
    },
    "app/api/jobs/**": {
      "maxDuration": 60
    },
    "app/api/ai/**": {
      "maxDuration": 45
    },
    "app/api/blockchain/**": {
      "maxDuration": 60
    },
    "app/api/rpa/**": {
      "maxDuration": 45
    }
  },
  "regions": ["bom1", "sin1"],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/jobs/cleanup",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/jobs/digest",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/jobs/trending/refresh",
      "schedule": "*/15 * * * *"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "build": {
    "env": {
      "NEXT_TELEMETRY_DISABLED": "1"
    }
  },
  "rewrites": [
    {
      "source": "/api/payments/razorpay/webhook",
      "destination": "/api/payments/razorpay/webhook"
    }
  ]
}
